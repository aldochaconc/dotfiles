{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": true,
  "autoMemoryEnabled": false,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "caveman@caveman": true,
    "plugin-dev@claude-code-plugins": true,
    "ponytail@ponytail": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "claude-code-plugins": {
      "source": {
        "repo": "anthropics/claude-code",
        "source": "github",
        "sparsePaths": [
          ".claude-plugin",
          "plugins"
        ]
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/register-check.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/command-audit.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/file-protection.py",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/register-check.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/destructive-git.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/tracked-rm.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/one-action-per-call.py",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/gate-skill-writes.py",
            "statusMessage": "Checking a skill write…",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash"
      },
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/writing-loaded.py",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 ~/.claude/hooks/session-register.py",
            "statusMessage": "Loading the speaking rules…",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  },
  "inputNeededNotifEnabled": false,
  "language": "English",
  "mcpServers": {
    "github-projects": {
      "args": [
        "mcp-github-projects"
      ],
      "command": "uvx",
      "env": {
        "GITHUB_TOKEN": "${GITHUB_PAT}"
      }
    },
    "googleDrive": {
      "args": [
        "@HOME@/Work/mcp-servers/googleDriveMCP/build/index.js"
      ],
      "command": "node",
      "env": {
        "CLIENT_ID": "${GCP_CLIENT_ID}",
        "CLIENT_SECRET": "${GCP_CLIENT_SECRET}",
        "REDIRECT_URI": "http://localhost:3000"
      }
    }
  },
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "permissions": {
    "allow": [
      "mcp__googleDrive__get-file-download-link",
      "mcp__googleDrive__list-all-folders",
      "mcp__googleDrive__list-files-in-folder",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(done)",
      "Bash(npm run type-check:*)",
      "Bash(gt status:*)",
      "Bash(gt modify:*)",
      "Bash(gt ls:*)",
      "Bash(gt log:*)",
      "Bash(gt info:*)",
      "Bash(gt state:*)",
      "Bash(gt top:*)",
      "Bash(gt bottom:*)",
      "Bash(gt up:*)",
      "Bash(gt down:*)",
      "Bash(gt checkout:*)",
      "Bash(npm run build:*)",
      "mcp__claude_ai_Linear__get_issue",
      "Bash(gt add:*)",
      "Bash(gt create:*)",
      "Bash(gt sync:*)",
      "Bash(gt restack:*)",
      "Bash(gt move:*)",
      "Bash(gt reorder:*)",
      "Bash(gt rename:*)",
      "Bash(gt track:*)",
      "Bash(gt untrack:*)",
      "Bash(gt continue:*)",
      "Bash(git checkout:*)",
      "Bash(git rm:*)",
      "Bash(rm ~/Work/:*)",
      "Bash(rm -f ~/Work/:*)",
      "Bash(rm ~/dotfiles/:*)",
      "Bash(rm -f ~/dotfiles/:*)",
      "Bash(rm /tmp/claude-:*)",
      "Bash(rm -f /tmp/claude-:*)",
      "Bash(rm -rf /tmp/claude-:*)",
      "Bash(curl -fsS:*)",
      "Bash(curl -fsSL:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sI:*)",
      "Bash(curl -sL:*)",
      "WebFetch",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(jq:*)",
      "Bash(sed -n:*)",
      "Bash(awk:*)",
      "Bash(comm:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(echo:*)",
      "Bash(pwd:*)",
      "Bash(date:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pytest:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Write(~/Work/**)",
      "Edit(~/Work/**)",
      "MultiEdit(~/Work/**)",
      "Write(~/dotfiles/**)",
      "Edit(~/dotfiles/**)",
      "MultiEdit(~/dotfiles/**)",
      "Write(/tmp/claude-**)",
      "Edit(/tmp/claude-**)",
      "MultiEdit(/tmp/claude-**)",
      "Read(~/Work/**)",
      "Read(~/dotfiles/**)",
      "Read(/tmp/claude-**)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(wget:*)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*apikey*)",
      "Edit(**/*api_key*)",
      "Edit(**/*keystore*)",
      "Edit(**/*.secret)",
      "Edit(**/secrets.json)",
      "Edit(**/secrets.y*ml)",
      "Edit(.aws/**)",
      "Edit(.env)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Edit(.ssh/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*apikey*)",
      "Read(**/*api_key*)",
      "Read(**/*keystore*)",
      "Read(**/*.secret)",
      "Read(**/secrets.json)",
      "Read(**/secrets.y*ml)",
      "Read(.aws/**)",
      "Read(.env)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.ssh/**)"
    ]
  },
  "promptSuggestionEnabled": false,
  "sandbox": {
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.graphite.dev",
        "api.linear.app",
        "registry.npmjs.org",
        "*.npmjs.org",
        "*.npmjs.com",
        "pypi.org",
        "files.pythonhosted.org",
        "*.amazonaws.com",
        "api.anthropic.com"
      ],
      "strictAllowlist": true
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "syntaxHighlightingDisabled": false,
  "theme": "dark-daltonized",
  "tui": "fullscreen",
  "verbose": false
}
