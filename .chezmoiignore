# Regenerated by Python on every hook run, in $HOME and here: never applied, never re-added.
.claude/hooks/__pycache__

# Thunar rewrites these itself as the window is used (pane sizes, view mode, accelerators).
# Only uca.xml, the context-menu actions, is versioned.
.config/Thunar/thunarrc
.config/Thunar/accels.scm

# herdr keeps its runtime state beside its config: sockets, logs, the session it restores
# on restart. Only config.toml is versioned.
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/session-history.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock


