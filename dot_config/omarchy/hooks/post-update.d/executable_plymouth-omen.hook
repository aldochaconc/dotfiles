#!/bin/bash

set -e

# omarchy-settings owns /usr/share/plymouth/themes/omarchy/{logo.png,omarchy.script} and neither
# is in its backup list, so a package update restores the stock logo and colours. Reapply the
# omen boot screen (tux on solid black, text in the theme foreground) when either drifted.
# Sudo is already live here. Same call as the manual step in README.md.
theme_dir=$(omarchy-theme-dir omen)
plymouth=/usr/share/plymouth/themes/omarchy
if ! cmp -s "$theme_dir/unlock.png" "$plymouth/logo.png" ||
   ! grep -q 'SetBackgroundTopColor(0.000, 0.000, 0.000)' "$plymouth/omarchy.script"; then
  omarchy-plymouth-set "#000000" "#dcd7ba" "$theme_dir/unlock.png"
fi
