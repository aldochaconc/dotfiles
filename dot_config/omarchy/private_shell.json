{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "payton.forecast"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "local.workspaces"
        }
      ],
      "right": [
        {
          "hidden": [],
          "id": "omarchy.tray",
          "pinned": []
        },
        {
          "id": "pinta365.nothing-control"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "alwaysShow": true,
          "id": "wian47.removable-drives"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        },
        {
          "id": "jesusarchive.keyboard-layout-switcher"
        },
        {
          "alwaysShow": true,
          "id": "omarchy.indicators"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "bobbynicholas.omaland"
    },
    {
      "id": "io.github.maajix.spotlight"
    },
    {
      "id": "io.github.tallsam.navbar-cat"
    },
    {
      "id": "shell.settings"
    },
    {
      "id": "zen.lock"
    },
    {
      "id": "taylorburke.sudo-watch"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "zen.lock"
  ]
}
