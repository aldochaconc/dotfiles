-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Disable all Omarchy default bindings. Add your own in hypr/bindings.lua.
omarchy_default_bindings = false
--
-- Or disable only bindings for Omarchy's preinstalled apps/web apps while
-- keeping core window-manager bindings:
-- omarchy_preinstalled_bindings = false

-- Load Omarchy defaults.
require("default.hypr.omarchy")
{{ if .hybrid_gpu }}
-- Hardware video decode on the GPU that composites. Omarchy's default/hypr/nvidia.lua sets
-- LIBVA_DRIVER_NAME=nvidia whenever a GSP-era NVIDIA GPU is present, keyed on the PCI device ID
-- alone. Here AQ_DRM_DEVICES puts the AMD iGPU first, so Hyprland and Chromium render on amdgpu
-- while decode lands on NVDEC, whose frames carry an NVIDIA-only DRM modifier radeonsi cannot
-- import: video goes black or white, and a feed with autoplaying video strobes the whole window
-- on every corrupted frame (omacom/omarchy#9708, #12674; fix pending upstream in PR #7851).
--
-- An hl.env here, after the defaults above, is the only override that holds: nvidia.lua re-runs
-- its hl.env at launch and on every reload and exports it to the systemd user environment, so a
-- value set earlier in uwsm/env.d is overwritten before any client sees it. The last hl.env wins.
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
{{- end }}

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- Add any other personal Hyprland configuration below.
-- o.window("qemu", { workspace = "5" })

-- Messaging apps open straight into the scratchpad, out of the way of whatever workspace is
-- in front. SUPER + SHIFT + W and SUPER + SHIFT + S reveal one, SUPER + S reveals both.
-- "silent" keeps the focus where it already is when they start.
-- Slack closes its window to the tray rather than exiting, so it can come back from its
-- pinned icon too; WhatsApp is a Chromium web app, so closing its window ends the process
-- and the scratchpad is the only thing keeping it alive.
o.window("^(slack)$", { workspace = "special:scratchpad silent" })
o.window("^(chrome-web\\.whatsapp\\.com__-Default)$", { workspace = "special:scratchpad silent" })

-- Music sits on workspace 6, behind the five the bar shows, so it is never in the way of
-- the workspaces in rotation. No "silent": SUPER + SHIFT + M is pressed to look at Spotify,
-- so the workspace comes along.
-- Class is "Spotify", not the "spotify" its desktop file declares as StartupWMClass.
-- Album art and player artwork are the content, so the 0.985/0.96 default opacity goes,
-- the same treatment Omarchy gives vlc and mpv.
o.window("^(Spotify)$", { workspace = "6" })
o.window("^(Spotify)$", { tag = "-default-opacity", opacity = "1 1" })

-- Settings and file-picking GUIs, opened to do one thing and closed again. Thunar replaces
-- Nautilus here (see the file-manager bindings); Aether themes the desktop; OmenSpace is
-- the HP hardware panel.
--
-- Omarchy's floating-window tag is deliberately not used: it carries size = { 875, 600 }
-- from default/hypr/apps/system.lua, and that tag rule outranks a later size rule matched
-- on class, so the window opens at 875x600 whatever is written here. float, center and
-- size are set directly instead, one property per rule, the way system.lua writes them.
--
-- 875x600 is too small for all three: Thunar's image preview pane squeezes the file list,
-- and both panels ship layouts taller than 600, which turns into scrolling. A fraction of
-- the monitor rather than a pixel count never exceeds the screen, on this 1920x1080 or on
-- anything else, so no clamp is needed; Omarchy sizes its webcam overlay the same way.
local floating_panels = "^(thunar|Aether|org\\.hp\\.OmenSpace)$"

o.window(floating_panels, { float = true })
o.window(floating_panels, { size = { "(monitor_w*0.8)", "(monitor_h*0.85)" } })
o.window(floating_panels, { center = true })

-- SQL grids, ER diagrams and syntax highlighting are read through the window, so the
-- 0.985/0.96 default opacity goes. Same treatment Omarchy gives vlc, mpv and kdenlive.
-- Workspace 7 keeps a long-running database session out of the five the bar shows, next
-- to Spotify on 6.
o.window("^(DBeaver)$", { workspace = "7", tag = "-default-opacity", opacity = "1 1" })

-- Window rules Omarchy applies by default (default/hypr/windows.lua, Omarchy 4.0.4-1), for
-- reference. A rule written in this file runs after them; for the same window and property
-- the later rule wins.
