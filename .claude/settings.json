      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ],
    "deny": [
      "Edit(**/*key*)",
      "Edit(**/*secret*)",
      "Edit(.aws/**)",
      "Edit(.env)",
      "Edit(.npmrc)",
      "Edit(.pypirc)",
      "Edit(.ssh/**)",
      "Read(**/*key*)",
      "Read(**/*secret*)",
      "Read(.aws/**)",
      "Read(.env)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(.ssh/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && ./.claude/hooks/guard-private.sh \"$f\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" 2>/dev/null || exit 0; git ls-files -co --exclude-standard | xargs -r ./.claude/hooks/guard-private.sh >&2 || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/register-check.py"
          }
        ]
      }
    ]
  }
}
