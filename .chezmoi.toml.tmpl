{{- /* Asked once per machine on `chezmoi init`; answers persist in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $hybrid_gpu := promptBoolOnce . "hybrid_gpu" "Hybrid AMD+NVIDIA laptop (supergfxd Hybrid, AQ_DRM_DEVICES for Hyprland)" -}}
{{- $panel_144hz := promptBoolOnce . "panel_144hz" "Laptop panel eDP-1 pinned to 1920x1080@144" -}}
{{- $hdmi_100hz := promptBoolOnce . "hdmi_100hz" "External HDMI-A-1 pinned to 1920x1080@100" -}}
{{- $gdrive := promptStringOnce . "gdrive_mcp_path" "Path to the Google Drive MCP build (index.js), empty if none" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  hybrid_gpu = {{ $hybrid_gpu }}
  panel_144hz = {{ $panel_144hz }}
  hdmi_100hz = {{ $hdmi_100hz }}
  gdrive_mcp_path = {{ $gdrive | quote }}
  # Extra project roots Claude Code may read. Edited by hand in this file, never in git;
  # carried over unchanged when chezmoi regenerates the config.
  claude_additional_dirs = {{ if hasKey . "claude_additional_dirs" }}{{ .claude_additional_dirs | toJson }}{{ else }}[]{{ end }}
